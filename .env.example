# Copy to .env.local and fill in. Never commit .env.local.
# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Public origin used for canonical URLs, sitemap and OG tags (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, server-only: salt for hashing client IPs in the rate limiter.
# Any long random string. Do NOT prefix with NEXT_PUBLIC_.
RATE_LIMIT_SALT=
